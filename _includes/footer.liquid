{% capture footer_contents %}
  &copy; Copyright 2026 SeoJin Jeong. Powered by Jekyll with al-folio theme. Hosted by GitHub Pages.
{% endcapture %}

{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0">
      {% if site.enable_footer_social %}
        <hr>
        {% include custom_social_links.liquid %}
        <br>
        {{ site.footer_message }}
        <hr>
      {% endif %}
      {{ footer_contents }}
    </div>
  </footer>
{% else %}
  <footer class="sticky-bottom mt-5" role="contentinfo">
    <div class="container">
      {% if site.enable_footer_social %}
        <hr>
        {% include custom_social_links.liquid %}
        <br>
        {{ site.footer_message }}
        <hr>
      {% endif %}
      {{ footer_contents }}
    </div>
  </footer>
{% endif %}